{
  "about": "Naturalness scripts for #143. Synthetic only; no real conversation text. A turn is {\"say\": user text} or {\"es\": what Es said by itself, \"source\": pet|notice|voice|timer}. \"refers\": words of which the reply should contain at least one (does it answer what was just said?). \"asks_ability\": the user asked about Es's own abilities, so explaining them is fine. mode: work|talk.",
  "scripts": [
    {"id": "smalltalk-cooking", "kind": "雑談", "mode": "talk", "tasks": [],
     "turns": [{"say": "今日はカレーを作ったよ", "refers": ["カレー"]},
               {"say": "スパイスから作ってみた", "refers": ["スパイス"]},
               {"say": "ちょっと辛すぎたかも", "refers": ["辛"]},
               {"say": "次はヨーグルトを入れてみる", "refers": ["ヨーグルト"]}]},
    {"id": "smalltalk-game", "kind": "雑談", "mode": "talk", "tasks": [],
     "turns": [{"say": "いまゲームの実況を見てるんだけど面白いよ", "refers": ["実況", "ゲーム"]},
               {"say": "ボス戦で三回くらい負けてた", "refers": ["ボス", "負け", "三回"]},
               {"say": "最後はギリギリで勝ってた", "refers": ["勝", "ギリギリ"]}]},
    {"id": "feelings-tired", "kind": "気持ち", "mode": "talk", "tasks": [],
     "turns": [{"say": "今日はちょっと疲れた", "refers": ["疲れ"]},
               {"say": "面接が二つあったんだ", "refers": ["面接"]},
               {"say": "片方はうまく話せなかった気がする", "refers": ["話せ", "うまく", "面接"]}]},
    {"id": "feelings-anxious", "kind": "気持ち", "mode": "work", "tasks": [{"title": "合成のES提出", "due": "+2"}],
     "turns": [{"say": "締切が近くてちょっと不安", "refers": ["不安", "締切"]},
               {"say": "書き出しが決まらないんだよね", "refers": ["書き出し"]}]},
    {"id": "talk-to-operation", "kind": "雑談から操作", "mode": "work", "tasks": [{"title": "合成の資料"}],
     "turns": [{"say": "最近寒くなってきたね", "refers": ["寒"]},
               {"say": "そういえば買い物をタスクに追加して", "refers": ["買い物"]},
               {"say": "ありがとう、助かる", "refers": []}]},
    {"id": "reply-to-es-nightowl", "kind": "Esの発言への返事", "mode": "talk", "tasks": [],
     "turns": [{"es": "夜更かし？無理しないでね", "source": "pet"},
               {"say": "大丈夫だよ", "refers": ["夜", "無理", "寝", "休"]}]},
    {"id": "reply-to-es-focus", "kind": "Esの発言への返事", "mode": "work", "tasks": [{"title": "合成の資料"}],
     "turns": [{"es": "おつかれさま！「合成の資料」、終わった？", "source": "timer"},
               {"say": "まだ途中", "refers": ["合成の資料", "資料", "続き", "次"]}]},
    {"id": "correction", "kind": "訂正", "mode": "talk", "tasks": [],
     "turns": [{"say": "昨日は映画を見たよ", "refers": ["映画"]},
               {"say": "あ、映画じゃなくてドラマだった", "refers": ["ドラマ"]},
               {"say": "最終回だったんだ", "refers": ["最終回"]}]},
    {"id": "ability-question", "kind": "能力の質問", "mode": "talk", "tasks": [],
     "turns": [{"say": "Esって音楽聞こえる？", "refers": ["音", "聞こえ"], "asks_ability": true},
               {"say": "そっか、じゃあ今流れてる曲の話をするね", "refers": ["曲"]}]}
  ]
}
